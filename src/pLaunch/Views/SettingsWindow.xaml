<Window x:Class="pLaunch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:pLaunch.Controls"
        Title="pLaunch settings"
        Width="560"
        SizeToContent="Height"
        MaxHeight="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Button HorizontalAlignment="Right" Margin="0" MinWidth="100" Content="Close" IsCancel="True" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="Close_Click" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,16">

                <!-- ================= Appearance ================= -->
                <TextBlock Text="Appearance" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="View" Style="{StaticResource Label}" />
                    <ComboBox x:Name="ViewBox" Grid.Column="1" SelectionChanged="ViewBox_SelectionChanged" />
                    <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Label}" />
                    <ComboBox x:Name="SizeBox" Grid.Row="1" Grid.Column="1" SelectionChanged="SizeBox_SelectionChanged" />
                    <TextBlock Grid.Row="2" Text="Order" Style="{StaticResource Label}" />
                    <ComboBox x:Name="SortBox" Grid.Row="2" Grid.Column="1" SelectionChanged="SortBox_SelectionChanged" />
                    <TextBlock Grid.Row="3" Text="Theme" Style="{StaticResource Label}" />
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <ComboBox x:Name="ThemeBox" SelectionChanged="ThemeBox_SelectionChanged" />
                        <TextBlock x:Name="ThemeNote" Margin="0,-4,0,8" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="With a custom background the text turns light or dark by itself." />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="Background" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,16,8" />
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="BackgroundBox" SelectionChanged="BackgroundBox_SelectionChanged" />
                            <Button x:Name="CustomColorButton" Margin="8,0,0,8" Content="Custom color&#x2026;" Click="CustomColor_Click" />
                        </StackPanel>
                        <CheckBox x:Name="TranslucentBox" Content="Translucent (a little of the acrylic shows through)"
                                  Click="TranslucentBox_Click" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="WebIconsBox" Margin="0,4,0,6" Content="Show website icons for web links (fetched once from each site)"
                          Click="WebIconsBox_Click" />

                <!-- ================= Behavior ================= -->
                <TextBlock Text="Behavior" Style="{StaticResource Section}" />
                <CheckBox x:Name="AutostartBox" Content="Start with Windows" Click="AutostartBox_Click" />
                <TextBlock Margin="0,10,0,6" Text="Shortcut to open this list from anywhere" />
                <DockPanel>
                    <CheckBox x:Name="HotkeyWinBox" DockPanel.Dock="Left" Margin="0,0,10,8" VerticalAlignment="Center" Content="Win +" Click="HotkeyWinBox_Click" />
                    <Button DockPanel.Dock="Right" Margin="0,0,0,8" Content="None" Click="HotkeyClear_Click" />
                    <Button DockPanel.Dock="Right" Margin="0,0,8,8" Content="Apply" Click="HotkeyApply_Click" />
                    <controls:HotkeyBox x:Name="HotkeyBox" Margin="0,0,8,8" />
                </DockPanel>
                <TextBlock x:Name="HotkeyStatus" Margin="0,0,0,6" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="ButtonIconPanel" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Taskbar icon of this list" Style="{StaticResource Label}" />
                    <Button Content="Change&#x2026;" Click="ButtonIcon_Click" />
                    <Button x:Name="DefaultButtonIconButton" Content="Default" Click="DefaultButtonIcon_Click" />
                </StackPanel>

                <!-- ================= Backup and sync ================= -->
                <TextBlock Text="Backup and sync" Style="{StaticResource Section}" />
                <WrapPanel>
                    <Button Content="Export this list&#x2026;" Click="Export_Click" />
                    <Button Content="Import a list&#x2026;" Click="Import_Click" />
                    <Button Content="Move data folder&#x2026;" Click="MoveData_Click"
                            ToolTip="E.g. a OneDrive folder, to share the lists between PCs" />
                    <Button Content="Open data folder" Click="OpenData_Click" />
                </WrapPanel>
                <TextBlock x:Name="DataFolderText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- ================= Updates ================= -->
                <TextBlock Text="Updates" Style="{StaticResource Section}" />
                <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically (once a day)" Click="AutoUpdateBox_Click" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Check now" Click="CheckNow_Click" />
                    <TextBlock x:Name="VersionText" VerticalAlignment="Center" Margin="4,0,0,8"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
