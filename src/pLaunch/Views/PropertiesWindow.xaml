<Window x:Class="pLaunch.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:pLaunch.Controls"
        Title="Properties"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Icon -->
        <DockPanel Margin="0,0,0,16">
            <Border Width="56" Height="56" CornerRadius="6" Margin="0,0,16,0"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <Grid>
                    <Image x:Name="IconPreview" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Glyph}" FontSize="32" HorizontalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="KindText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button x:Name="ChangeIconButton" Content="Change icon&#x2026;" Click="ChangeIcon_Click" />
                    <Button x:Name="DefaultIconButton" Margin="8,0,0,0" Content="Default icon" Click="DefaultIcon_Click" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Fields -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock" x:Key="FieldLabel">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,12,8" />
                </Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </Grid.Resources>

            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="2" />

            <TextBlock x:Name="TargetLabel" Grid.Row="1" Text="Target" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TargetBox" Grid.Row="1" Grid.Column="1" />
            <Button x:Name="BrowseTargetButton" Grid.Row="1" Grid.Column="2" Margin="8,0,0,8" Content="&#x2026;"
                    ToolTip="Browse" Click="BrowseTarget_Click" />

            <TextBlock x:Name="ArgumentsLabel" Grid.Row="2" Text="Arguments" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ArgumentsBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" />

            <TextBlock x:Name="StartInLabel" Grid.Row="3" Text="Start in" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="StartInBox" Grid.Row="3" Grid.Column="1"
                     ToolTip="Empty: the folder of the target. Environment variables such as %USERPROFILE% work." />
            <Button x:Name="BrowseStartInButton" Grid.Row="3" Grid.Column="2" Margin="8,0,0,8" Content="&#x2026;"
                    ToolTip="Browse" Click="BrowseStartIn_Click" />

            <TextBlock x:Name="StartWindowLabel" Grid.Row="4" Text="Window" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="StartWindowBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" MinWidth="180"
                      HorizontalAlignment="Left" ToolTip="How the program's window opens (some programs ignore it)">
                <ComboBoxItem Content="Normal" />
                <ComboBoxItem Content="Minimized" />
                <ComboBoxItem Content="Maximized" />
            </ComboBox>

            <TextBlock x:Name="HotkeyLabel" Grid.Row="5" Text="Shortcut" Style="{StaticResource FieldLabel}" />
            <DockPanel x:Name="HotkeyPanel" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                       ToolTip="Opens the item from anywhere, without opening pLaunch">
                <CheckBox x:Name="HotkeyWinBox" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" Content="Win +" Click="HotkeyWinBox_Click" />
                <controls:HotkeyBox x:Name="HotkeyBox" />
            </DockPanel>

            <CheckBox x:Name="ShowContentsBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                      Content="Show the folder's content inside pLaunch (a click opens it here)" />

            <CheckBox x:Name="RunAsAdminBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                      Content="Always run as administrator" />

            <TextBlock x:Name="UsageText" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" MinWidth="90" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" />
            <Button Margin="8,0,0,0" Content="Cancel" MinWidth="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
