<Window x:Class="pLaunch.Views.FolderMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pLaunch"
        Width="320" Height="200"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        AllowDrop="True"
        UseLayoutRounding="True">

    <!-- Same frame as the popup: DWM shadow, rounded corners and backdrop, nothing to resize -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root">
        <Grid>
            <!-- Never focusable: giving a row the focus would activate this window (Win32 SetFocus), the
                 popup would lose the focus and close before the click does anything -->
            <ListBox x:Name="List" Margin="4,6" Background="Transparent" BorderThickness="0"
                     SelectionMode="Single" Focusable="False"
                     IsTextSearchEnabled="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListBox.ContextMenu>
                    <ContextMenu />
                </ListBox.ContextMenu>
            </ListBox>
            <TextBlock x:Name="EmptyText" Margin="20,16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Border>
</Window>
