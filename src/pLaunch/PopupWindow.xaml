<Window x:Class="pLaunch.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:pLaunch.ViewModels"
        Title="pLaunch"
        Icon="Assets/pLaunch.ico"
        Width="320" Height="240"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="Transparent"
        AllowDrop="True"
        UseLayoutRounding="True">

    <!-- Client area over the whole window: keeps the DWM shadow, rounded corners and backdrop of a
         resizable window, while ResizeBorderThickness=0 leaves nothing to resize -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Set from code (ViewMetrics) for the chosen view and size -->
        <sys:Double x:Key="IconSize">24</sys:Double>
        <sys:Double x:Key="GlyphSize">20</sys:Double>
        <sys:Double x:Key="RowHeight">38</sys:Double>
        <sys:Double x:Key="TileWidth">92</sys:Double>
        <sys:Double x:Key="TileHeight">104</sys:Double>
        <sys:Double x:Key="SeparatorWidth">300</sys:Double>

        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <StackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Separators: no hover/selection look, not focusable (keyboard navigation skips them) -->
        <ControlTemplate x:Key="PlainContainer" TargetType="ListBoxItem">
            <ContentPresenter />
        </ControlTemplate>

        <!-- The Fluent rows are much taller than a menu's -->
        <Style x:Key="ListContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template" Value="{StaticResource PlainContainer}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template" Value="{StaticResource PlainContainer}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= List: icon and name on one row ================= -->
        <DataTemplate x:Key="ListItemTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid x:Name="Row" Height="{DynamicResource RowHeight}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="3" Margin="-8,1" CornerRadius="4" BorderThickness="2"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropInto, Converter={StaticResource BoolToVisibility}}" />

                <Image Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Source="{Binding Icon}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock x:Name="FallbackGlyph" Width="{DynamicResource IconSize}" Text="{Binding Glyph}"
                           Style="{StaticResource Glyph}" FontSize="{DynamicResource GlyphSize}" TextAlignment="Center" />
                <!-- Running: a short line under the icon, like on the taskbar -->
                <Border Width="8" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2"
                        Background="{DynamicResource TextFillColorSecondaryBrush}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center"
                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="RenameBox" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                         KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus" />

                <!-- Sub-folders: how many shortcuts, and a chevron (a click opens it) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Visibility="{Binding IsNavigable, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding ChildInfo}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Margin="8,0,2,0" Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.ColumnSpan="3" Height="2" Margin="0,-3,0,0" VerticalAlignment="Top" CornerRadius="1"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
                <Border Grid.ColumnSpan="3" Height="2" Margin="0,0,0,-3" VerticalAlignment="Bottom" CornerRadius="1"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter TargetName="FallbackGlyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= Tiles: big icon, name below ================= -->
        <DataTemplate x:Key="GridItemTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid x:Name="Tile" Width="{DynamicResource TileWidth}" Height="{DynamicResource TileHeight}"
                  Background="Transparent">
                <Border CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropInto, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Margin="0,8,0,0" VerticalAlignment="Top">
                    <Grid Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock x:Name="FallbackGlyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}"
                                   FontSize="{DynamicResource GlyphSize}" HorizontalAlignment="Center" />
                        <Border Width="8" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-6"
                                Background="{DynamicResource TextFillColorSecondaryBrush}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Grid Margin="3,6,3,0">
                        <TextBlock MaxHeight="34" FontSize="12" Text="{Binding Name}" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="RenameBox" FontSize="12" VerticalAlignment="Top"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                 KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                    </Grid>
                </StackPanel>
                <Border Width="2" Margin="-3,6,0,6" HorizontalAlignment="Left" CornerRadius="1"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
                <Border Width="2" Margin="0,6,-3,6" HorizontalAlignment="Right" CornerRadius="1"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter TargetName="FallbackGlyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= Icons only (names in the tooltip) ================= -->
        <DataTemplate x:Key="IconItemTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid x:Name="Tile" Width="{DynamicResource TileWidth}" Height="{DynamicResource TileHeight}"
                  Background="Transparent" ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="400">
                <Border CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropInto, Converter={StaticResource BoolToVisibility}}" />
                <Grid Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}">
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="FallbackGlyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}"
                               FontSize="{DynamicResource GlyphSize}" HorizontalAlignment="Center" />
                    <Border Width="8" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-6"
                            Background="{DynamicResource TextFillColorSecondaryBrush}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <!-- No room for a name: renaming uses the window's RenameOverlay, placed below the tile -->
                <Border Width="2" Margin="-3,4,0,4" HorizontalAlignment="Left" CornerRadius="1"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
                <Border Width="2" Margin="0,4,-3,4" HorizontalAlignment="Right" CornerRadius="1"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter TargetName="FallbackGlyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= Separators ================= -->
        <DataTemplate x:Key="SeparatorListTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid Height="13" Margin="10,0" Background="Transparent">
                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Border Height="2" VerticalAlignment="Top" CornerRadius="1" Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
                <Border Height="2" VerticalAlignment="Bottom" CornerRadius="1" Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- A whole row of tiles: the width makes the WrapPanel put it on a line of its own -->
        <DataTemplate x:Key="SeparatorTileTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid Width="{DynamicResource SeparatorWidth}" Height="13" Background="Transparent">
                <Border Height="1" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Border Height="2" VerticalAlignment="Top" CornerRadius="1" Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
                <Border Height="2" VerticalAlignment="Bottom" CornerRadius="1" Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Inside a sub-folder: back button and path. Dropping here moves up one level; holding a drag
                 over it goes back. -->
            <Border x:Name="Header" Padding="6,4" BorderThickness="0,0,0,1" Visibility="Collapsed" Background="Transparent"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" AllowDrop="True"
                    DragEnter="Header_DragOver" DragOver="Header_DragOver" DragLeave="Header_DragLeave" Drop="Header_Drop">
                <DockPanel>
                    <Button x:Name="BackButton" Style="{StaticResource FooterButton}" ToolTip="Back (Backspace)"
                            Click="BackButton_Click">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" />
                    </Button>
                    <TextBlock x:Name="HeaderTitle" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Search: appears as soon as something is typed; filters the whole list (every sub-folder) -->
            <Border x:Name="SearchBar" Padding="8,6" BorderThickness="0,0,0,1" Visibility="Collapsed"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Margin="2,0,8,0" Text="&#xE721;" Style="{StaticResource Glyph}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource FooterButton}" ToolTip="Clear (Esc)"
                            Click="ClearSearch_Click">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12" />
                    </Button>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                </DockPanel>
            </Border>

            <!-- Extended: Ctrl+click / Shift+click select several items, Enter opens them all -->
            <ListBox x:Name="List" Grid.Row="1" Margin="4,6,4,2" Background="Transparent" BorderThickness="0"
                     SelectionMode="Extended"
                     IsTextSearchEnabled="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="False"
                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="List_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                     PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                     ContextMenuOpening="List_ContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu />
                </ListBox.ContextMenu>
            </ListBox>

            <StackPanel x:Name="EmptyHint" Grid.Row="1" Margin="24,28,24,24" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock HorizontalAlignment="Center" Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="28"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EmptyHintText" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- A newer version is available (automatic check) -->
            <Border x:Name="UpdateBanner" Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0" Visibility="Collapsed"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0" Text="&#xE896;" Style="{StaticResource Glyph}"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ProgressBar x:Name="UpdateProgress" Margin="0,8,0,0" Height="4" Maximum="1" Visibility="Collapsed" />
                    <StackPanel x:Name="UpdateButtons" Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Install" Style="{DynamicResource AccentButtonStyle}" Click="UpdateInstall_Click" />
                        <Button Margin="6,0,0,0" Content="Later" Click="UpdateLater_Click" />
                        <Button Margin="6,0,0,0" Content="Skip this version" Click="UpdateSkip_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Padding="6,4" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <DockPanel LastChildFill="False">
                    <Button x:Name="AddButton" DockPanel.Dock="Left" Style="{StaticResource FooterButton}"
                            ToolTip="Add" Click="AddButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" />
                            <TextBlock Margin="8,0,0,0" Text="Add" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MenuButton" DockPanel.Dock="Right" Style="{StaticResource FooterButton}"
                            ToolTip="More" Click="MenuButton_Click">
                        <TextBlock Text="&#xE712;" Style="{StaticResource Glyph}" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- Rename box for the icons-only view (tiles too small for one). It lives in the window, not in a
                 Popup, so it gets the keyboard like any other control; the canvas itself is not hit-testable.
                 It spans the footer too (and comes last, to be drawn over it), so there is room below even a
                 single row of tiles. -->
            <Canvas x:Name="RenameOverlay" Grid.Row="1" Grid.RowSpan="3" ClipToBounds="True">
                <!-- Solid host: the Fluent text box is translucent -->
                <Border x:Name="OverlayRenameHost" Visibility="Collapsed" CornerRadius="4"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <TextBox x:Name="OverlayRenameBox"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>
