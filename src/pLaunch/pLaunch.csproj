<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>pLaunch</RootNamespace>
    <AssemblyName>pLaunch</AssemblyName>
    <!-- Program.Main handles jump list launches and single-instance forwarding before WPF starts -->
    <StartupObject>pLaunch.Program</StartupObject>
    <ApplicationIcon>Assets\pLaunch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.6.0</Version>
    <Product>pLaunch</Product>
    <Authors>Phate</Authors>
    <Copyright>Copyright (C) 2026 Phate</Copyright>
    <!-- ThemeMode (the Fluent theme) is still marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled as a page: no generated Main, App is created by Program -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\pLaunch.ico" />
    <Resource Include="Assets\pLaunchWhite.ico" />
    <Resource Include="Assets\pLaunchBlack.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="pLaunch.Tests" />
  </ItemGroup>

</Project>
